# Local-only defaults. Copy to .env; never commit real secrets.
APP_ENV=development
JWT_SECRET=change-this-local-secret-before-deployment
DATABASE_PATH=data/diet_planner.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL_STORAGE_PATH=data/uploads

# Optional hosted database: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_URL=

# Optional S3-compatible object storage. Keep the bucket private.
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional OpenAI-compatible chat-completions API. Omit both to use local rules.
# AI_API_URL=
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
